---
const features = [
  { id: 'reloj', texto: 'Puntualidad garantizada.' },
  { id: 'taxi', texto: 'Vehículo nuevo y cómodo.' },
  { id: 'escudo', texto: 'Seguridad y confianza.' },
  { id: 'persona', texto: 'Atención cercana.' },
];
---

<section class="porque">
  <div class="contenedor">
    <h2 class="reveal reveal--up">¿Por qué elegir Taxi Xàtiva?</h2>
    <div class="porque__grid">
      {features.map((f, i) => (
        <div class="feature reveal reveal--up" style={`transition-delay:${i * 0.12}s`}>
          <div class="feature__icon">
            {f.id === 'reloj' && (
              <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <path d="M4 26h12M2 34h10M4 42h12" stroke="#ffd331" stroke-width="3" stroke-linecap="round"/>
                <circle cx="38" cy="34" r="18" stroke="#1a1a1a" stroke-width="3"/>
                <path d="M38 24v10l7 5" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {f.id === 'taxi' && (
              <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <rect x="20" y="8" width="24" height="8" rx="2" fill="#ffd331"/>
                <path d="M10 30l6-14h32l6 14z" fill="rgba(255,211,49,0.18)" stroke="#1a1a1a" stroke-width="2.5" stroke-linejoin="round"/>
                <rect x="4" y="30" width="56" height="14" rx="2.5" stroke="#1a1a1a" stroke-width="2.5"/>
                <circle cx="18" cy="44" r="8" fill="white" stroke="#1a1a1a" stroke-width="2.5"/>
                <circle cx="18" cy="44" r="3" fill="#1a1a1a"/>
                <circle cx="46" cy="44" r="8" fill="white" stroke="#1a1a1a" stroke-width="2.5"/>
                <circle cx="46" cy="44" r="3" fill="#1a1a1a"/>
              </svg>
            )}
            {f.id === 'escudo' && (
              <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <path d="M32 10l20 7v13c0 13-9 19.5-20 23-11-3.5-20-10-20-23V17l20-7Z" stroke="#1a1a1a" stroke-width="3" stroke-linejoin="round"/>
                <path d="M22 32l7 7 13-13" stroke="#ffd331" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {f.id === 'persona' && (
              <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <circle cx="32" cy="20" r="10" stroke="#1a1a1a" stroke-width="3"/>
                <path d="M15 52a17 17 0 0 1 34 0" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round"/>
                <path d="M24 36c2.5 3 13.5 3 16 0" stroke="#ffd331" stroke-width="3" stroke-linecap="round"/>
              </svg>
            )}
          </div>
          <p>{f.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
