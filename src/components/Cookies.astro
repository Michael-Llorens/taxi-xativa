---

<div class="cookies" id="cookies" hidden>
  <p class="cookies__txt">
    Usamos cookies técnicas y, solo si las aceptas, cookies de análisis de Google para
    saber cómo se usa la web. Consulta la
    <a href="/politica-cookies/">política de cookies</a>.
  </p>
  <div class="cookies__btns">
    <button type="button" class="cookies__btn cookies__btn--no" id="cookiesNo">Rechazar</button>
    <button type="button" class="cookies__btn cookies__btn--si" id="cookiesSi">Aceptar</button>
  </div>
</div>

<script>
  const KEY = 'taxi_cookies_ok';
  const box = document.getElementById('cookies');
  const leer = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  if (box && !leer()) {
    box.hidden = false;
    requestAnimationFrame(() => box.classList.add('is-visible'));
  }
  const cerrar = (valor: string) => {
    try { localStorage.setItem(KEY, valor); } catch {}
    box?.classList.remove('is-visible');
    setTimeout(() => { if (box) box.hidden = true; }, 300);
  };
  document.getElementById('cookiesSi')?.addEventListener('click', () => {
    cerrar('aceptado');
    (window as any)._gtmLoad?.();
  });
  document.getElementById('cookiesNo')?.addEventListener('click', () => cerrar('rechazado'));
</script>
