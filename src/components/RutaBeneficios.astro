---
interface Props {
  intro: string;
}
const { intro } = Astro.props;

const beneficios = [
  'Puntualidad garantizada, siempre a tiempo.',
  'Precio acordado de antemano, según la tarifa oficial.',
  'Vehículo amplio y cómodo, con sitio para tu equipaje.',
  'Recogida también a la vuelta: te esperamos a la llegada.',
  'Grupos grandes: coordino vehículos adicionales si lo necesitas.',
  'Pago en efectivo o con tarjeta.',
];
---

<section class="ruta-ben">
  <div class="contenedor ruta-ben__inner">
    <p class="ruta-ben__intro reveal reveal--up">{intro}</p>
    <ul class="ruta-ben__lista reveal reveal--up">
      {beneficios.map((b) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {b}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ruta-ben { padding: 64px 0 20px; }
  .ruta-ben__inner { max-width: 820px; }
  .ruta-ben__intro { font-size: 1.05rem; line-height: 1.7; color: #333; margin-bottom: 30px; }
  .ruta-ben__lista { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 28px; }
  .ruta-ben__lista li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.97rem;
    color: #222;
    line-height: 1.45;
  }
  .ruta-ben__lista svg {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    color: #fff;
    background: var(--whatsapp);
    border-radius: 50%;
    padding: 4px;
    margin-top: 1px;
  }
  @media (max-width: 680px) {
    .ruta-ben__lista { grid-template-columns: 1fr; }
  }
</style>
