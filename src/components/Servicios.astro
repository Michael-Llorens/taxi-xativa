---
import { getImage } from 'astro:assets';
import imgLocal from '../assets/img/servicio-local.webp';
import imgAero from '../assets/img/servicio-aeropuerto.webp';
import imgEmpresa from '../assets/img/servicio-empresas.webp';

const fuentes = [
  {
    img: imgLocal,
    titulo: 'Traslados locales en Xàtiva',
    texto: 'Desplazamientos por Xàtiva y toda La Costera con rutas rápidas y eficientes.',
  },
  {
    img: imgAero,
    titulo: 'Viajes a aeropuertos',
    texto: 'Traslados directos a los aeropuertos de Valencia, Alicante y otros destinos.',
  },
  {
    img: imgEmpresa,
    titulo: 'Empresas y particulares',
    texto: 'Servicio profesional para compañías, profesionales y desplazamientos personales.',
  },
];

const servicios = await Promise.all(
  fuentes.map(async (s) => ({
    titulo: s.titulo,
    texto: s.texto,
    src: (await getImage({ src: s.img, format: 'webp', width: 500, quality: 74 })).src,
  }))
);

---

<section class="servicios" id="servicios">
  <div class="contenedor">
    <h2 class="reveal reveal--up">Servicios destacados</h2>
    <p class="servicios__sub reveal reveal--up">
      Sea cual sea tu trayecto, te llevo con puntualidad, comodidad y un trato cercano.
    </p>
    <div class="servicios__grid">
      {servicios.map((s, i) => (
        <article class="tarjeta reveal reveal--up" style={`background-image:url('${s.src}');transition-delay:${i * 0.12}s`}>
          <div class="tarjeta__info">
            <h3 class="tarjeta__titulo">{s.titulo}</h3>
            <p class="tarjeta__texto">{s.texto}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
