---
import { getImage } from 'astro:assets';
import heroBg from '../assets/img/hero-1.webp';
// Mismo archivo que la versión grande del hero: ya está en caché
const bgOpt = await getImage({ src: heroBg, format: 'webp', width: 1036, quality: 60 });

const horario = [
  { dia: 'Lunes', horas: '9:00 – 21:00' },
  { dia: 'Martes', horas: '9:00 – 21:00' },
  { dia: 'Miércoles', horas: '9:00 – 21:00' },
  { dia: 'Jueves', horas: '9:00 – 21:00' },
  { dia: 'Viernes', horas: '9:00 – 21:00' },
  { dia: 'Sábado', horas: 'Cerrado' },
  { dia: 'Domingo', horas: 'Cerrado' },
];
---

<section
  class="contacto"
  id="contacto"
  data-bg={bgOpt.src}
>
  <div class="contenedor">
    <h2 class="reveal reveal--up">Contacto</h2>
    <div class="contacto__grid">
      <div class="horario reveal reveal--left">
        <h3 class="horario__titulo">
          <span class="horario__titulo-texto">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            Horario
          </span>
          <span class="horario__estado" id="horarioEstado">Comprobando horario…</span>
        </h3>
        <ul class="horario__lista">
          {horario.map((h) => (
            <li class={h.horas === 'Cerrado' ? 'is-cerrado' : ''}>
              <span class="horario__dia">{h.dia}</span>
              <span class="horario__hora">{h.horas}</span>
            </li>
          ))}
        </ul>
      </div>
      <form class="form reveal reveal--up" id="formReserva">
      <label class="sr-only" for="f-nombre">Nombre</label>
      <input id="f-nombre" type="text" name="nombre" placeholder="Nombre*" autocomplete="name" required />
      <label class="sr-only" for="f-telefono">Teléfono</label>
      <input id="f-telefono" type="tel" name="telefono" placeholder="Teléfono*" autocomplete="tel" required />
      <label class="sr-only" for="f-fyh">Fecha y hora del viaje</label>
      <input id="f-fyh" type="text" name="fyh" placeholder="Fecha y hora del viaje*" required />
      <label class="sr-only" for="f-oyd">Origen y destino</label>
      <input id="f-oyd" type="text" name="oyd" placeholder="Origen y destino*" required />
      <label class="form__check">
        <input type="checkbox" name="politica" required />
        <span>He leído y acepto la <a href="/politica-privacidad/">política de privacidad</a>.</span>
      </label>
      <button type="submit" class="btn-amarillo">Reserva</button>
      <p class="form__nota">Al enviar se abrirá <strong>WhatsApp</strong> con tu solicitud. Si prefieres el correo: <a href="mailto:ricardotaxixativa@gmail.com">ricardotaxixativa@gmail.com</a></p>
      <div class="form__separador"><span>o</span></div>
      <a href="tel:+34722267668" class="btn-amarillo btn-llamar">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 5.55 5.55l.86-.86a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 15.67z"/>
        </svg>
        722 26 76 68 — Llamar ahora
      </a>
    </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('formReserva') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: 'reserva_whatsapp' });

    const data = new FormData(form);
    const nombre = (data.get('nombre') || '').toString().trim();
    const telefono = (data.get('telefono') || '').toString().trim();
    const fyh = (data.get('fyh') || '').toString().trim();
    const oyd = (data.get('oyd') || '').toString().trim();

    const mensaje =
      `Hola Ricardo, quiero reservar un taxi:

` +
      `*Nombre:* ${nombre}
` +
      `*Teléfono:* ${telefono}
` +
      `*Fecha y hora:* ${fyh}
` +
      `*Origen y destino:* ${oyd}`;

    window.open(`https://wa.me/34722267668?text=${encodeURIComponent(mensaje)}`, '_blank', 'noopener');
  });

  document.querySelector('.btn-llamar')?.addEventListener('click', () => {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: 'llamada_telefono' });
  });

  // Fondo de la sección: se descarga solo cuando el usuario se acerca a ella
  const seccion = document.getElementById('contacto');
  const ponerFondo = () => {
    if (seccion?.dataset.bg) {
      seccion.style.backgroundImage = `linear-gradient(rgba(0,0,0,.62),rgba(0,0,0,.62)),url('${seccion.dataset.bg}')`;
    }
  };
  if (seccion && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        ponerFondo();
        io.disconnect();
      }
    }, { rootMargin: '600px 0px' });
    io.observe(seccion);
  } else {
    ponerFondo();
  }

  const estadoEl = document.getElementById('horarioEstado');
  if (estadoEl) {
    // Hora de España, aunque el visitante esté en otra zona horaria
    const partes = Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Madrid',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(new Date()).map((p) => [p.type, p.value])
    );
    const dia = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(partes.weekday);
    const horaActual = Number(partes.hour) + Number(partes.minute) / 60;
    const esLaborable = dia >= 1 && dia <= 5;
    const disponible = esLaborable && horaActual >= 9 && horaActual < 21;
    estadoEl.textContent = disponible ? 'Disponible ahora' : 'Cerrado ahora';
    estadoEl.classList.add(disponible ? 'is-disponible' : 'is-cerrado');
  }
</script>
