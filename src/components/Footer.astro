---
import { Image } from 'astro:assets';
import logoBlanco from '../assets/img/logo-blanco.webp';
import { rutas } from '../data/rutas';
---

<div class="tira-taxi"></div>
<footer class="pie">
  <div class="contenedor pie__grid">
    <div class="pie__logo">
      <Image src={logoBlanco} alt="Taxi Xàtiva" width={282} height={154} loading="lazy" />
    </div>
    <div>
      <h3>Servicios</h3>
      <ul class="pie__legales">
        {rutas.map((r) => <li><a href={`/${r.slug}/`}>{r.nombre}</a></li>)}
        <li><a href="/#servicios">Trayectos locales y empresas</a></li>
        <li><a href="/#calculadora">Calcular precio</a></li>
      </ul>
    </div>
    <div>
      <h3>Contacto</h3>
      <ul>
        <li>📞 <a href="tel:+34722267668">722 26 76 68</a></li>
        <li>✉️ <a href="mailto:ricardotaxixativa@gmail.com">ricardotaxixativa@gmail.com</a></li>
        <li>📍 Xàtiva (Valencia)</li>
        <li>
          <a href="https://wa.me/34722267668" target="_blank" rel="noopener">WhatsApp directo</a>
        </li>
      </ul>
    </div>
    <div>
      <h3>Textos legales</h3>
      <ul class="pie__legales">
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/politica-privacidad/">Política de privacidad</a></li>
        <li><a href="/politica-cookies/">Política de cookies</a></li>
        <li><button type="button" id="btnConfigCookies" class="pie__link-btn">Configurar cookies</button></li>
      </ul>
    </div>
  </div>
  <div class="pie__copy">
    <p>© 2026 Taxi Xàtiva — Ricardo Llorens. Todos los derechos reservados.</p>
  </div>
</footer>

<script>
  document.getElementById('btnConfigCookies')?.addEventListener('click', () => {
    try { localStorage.removeItem('taxi_cookies_ok'); } catch {}
    window.location.reload();
  });
</script>
