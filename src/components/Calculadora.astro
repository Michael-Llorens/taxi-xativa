---
const TARIFA_NORMAL = 10;
const TARIFA_FESTIVO = 15;
---

<section class="calc" id="calculadora">
  <div class="contenedor">
    <h2 class="reveal reveal--up">Calcula tu presupuesto</h2>
    <p class="calc__sub reveal reveal--up">
      Estimación orientativa para <strong>viajes largos</strong> (aeropuertos, larga distancia…).
      Indica los kilómetros y el tipo de día.
    </p>
    <p class="calc__aviso reveal reveal--up">
      ⓘ Los trayectos cortos tienen una <strong>tarifa estándar</strong>. Escríbeme y te la digo al momento.
    </p>

    <div class="calc__card reveal reveal--up">
      <div class="calc__campos">
        <div class="calc__campo">
          <label for="calcKm">Distancia del trayecto</label>
          <div class="calc__km">
            <input type="number" id="calcKm" min="1" max="500" value="10" inputmode="numeric" aria-label="Kilómetros" />
            <span>km</span>
          </div>
          <input type="range" id="calcRange" min="1" max="200" value="10" aria-label="Selector de kilómetros" />
        </div>

        <div class="calc__campo">
          <span class="calc__label">Tipo de día</span>
          <div class="calc__tarifas" role="group" aria-label="Tipo de día">
            <button type="button" class="calc__tarifa is-active" data-tarifa={TARIFA_NORMAL}>
              Día normal <small>{TARIFA_NORMAL} €/km</small>
            </button>
            <button type="button" class="calc__tarifa" data-tarifa={TARIFA_FESTIVO}>
              Festivo / domingo <small>{TARIFA_FESTIVO} €/km</small>
            </button>
          </div>
        </div>
      </div>

      <div class="calc__resultado">
        <span class="calc__res-label">Precio aproximado</span>
        <span class="calc__res-precio" id="calcPrecio">≈ 100 €</span>
        <span class="calc__res-detalle" id="calcDetalle">10 km × 10 €/km</span>
      </div>

      <a class="calc__reservar" id="calcReservar" href="https://wa.me/34722267668" target="_blank" rel="noopener">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.8 5.5 2.2 7.9L.5 31.5l7.8-2.1c2.3 1.3 4.9 1.9 7.6 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.4 0-4.7-.6-6.7-1.8l-.5-.3-4.6 1.2 1.2-4.5-.3-.5c-1.3-2.1-2-4.5-2-6.9C3.1 8.8 8.9 3 16 3s12.9 5.8 12.9 12.9S23.1 28.8 16 28.8zm7.1-9.6c-.4-.2-2.3-1.1-2.6-1.3-.3-.1-.6-.2-.8.2-.2.4-.9 1.3-1.2 1.5-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.4.5-.7.2-.2.2-.4.4-.7.1-.3 0-.5 0-.7-.1-.2-.8-2-1.1-2.7-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.5-.3.4-1.2 1.2-1.2 2.9 0 1.7 1.2 3.4 1.4 3.6.2.2 2.4 3.7 5.8 5.1.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.6.2-1.8-.1-.1-.3-.2-.7-.4z"/></svg>
        Reservar por WhatsApp
      </a>
    </div>

    <p class="calc__nota reveal reveal--up">
      * Cálculo orientativo para viajes largos. El importe final puede variar según el recorrido,
      esperas o la tarifa oficial vigente. Los trayectos cortos se rigen por la tarifa estándar.
    </p>
  </div>
</section>

<script>
  const km = document.getElementById('calcKm') as HTMLInputElement | null;
  const range = document.getElementById('calcRange') as HTMLInputElement | null;
  const precio = document.getElementById('calcPrecio');
  const detalle = document.getElementById('calcDetalle');
  const reservar = document.getElementById('calcReservar') as HTMLAnchorElement | null;
  const botones = document.querySelectorAll<HTMLButtonElement>('.calc__tarifa');

  if (km && range && precio && detalle && reservar) {
    let tarifa = 10;
    let tipoDia = 'día normal';
    const fmt = (n: number) => n.toLocaleString('es-ES');

    const actualizar = () => {
      let k = parseFloat(km.value);
      if (isNaN(k) || k < 0) k = 0;
      const total = Math.round(k * tarifa);
      precio.textContent = `≈ ${fmt(total)} €`;
      detalle.textContent = `${fmt(k)} km × ${tarifa} €/km`;
      const msg = encodeURIComponent(
        `¡Hola Ricardo! Quiero reservar un trayecto de ${k} km (${tipoDia}). Presupuesto aproximado: ${total} €.`
      );
      reservar.href = `https://wa.me/34722267668?text=${msg}`;
    };

    km.addEventListener('input', () => {
      const v = parseFloat(km.value);
      if (!isNaN(v)) range.value = String(Math.min(v, parseFloat(range.max)));
      actualizar();
    });
    range.addEventListener('input', () => {
      km.value = range.value;
      actualizar();
    });
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        botones.forEach((x) => x.classList.remove('is-active'));
        b.classList.add('is-active');
        tarifa = parseInt(b.dataset.tarifa || '10', 10);
        tipoDia = tarifa === 15 ? 'festivo o domingo' : 'día normal';
        actualizar();
      })
    );
    actualizar();
  }
</script>
