---
// Reseñas reales de 5★ de clientes en Google (perfil "Taxi Xativa Ricardo").
const GOOGLE_URL = 'https://maps.app.goo.gl/pBQKcu91jcASpt816';

const opiniones = [
  {
    texto:
      'No fue nuestra primera opción pero nos subió al Castillo de Xàtiva. Muy agradable y educado. Nos estuvo explicando cosas mientras nos llevaba. Teléfono guardado para próximos viajes. Lo recomiendo 100%.',
    autor: 'Erika Boix',
  },
  {
    texto:
      'Servicio espectacular. No dudes en llamarlo. Nos gestionó rápidamente el trayecto que necesitábamos a mis amigas y a mí. Contactó con un compañero porque no cabíamos en un taxi. Gracias a Ricardo pudimos coger un vuelo. Totalmente recomendable.',
    autor: 'Susana San Nicolás',
  },
  {
    texto:
      'Servicio estupendo y muy puntual. Gracias a Ricardo llegamos a tiempo al aeropuerto, nos gestionó todo, su taxi y el de un compañero, ya que éramos más de cuatro personas. Gracias a ti pudimos disfrutar nuestro viaje.',
    autor: 'Natalia Lage',
  },
  {
    texto:
      'Muy buen servicio. Taxista muy amable y profesional. Todo perfecto en mi trayecto al aeropuerto.',
    autor: 'R. Tasnim',
  },
  {
    texto: 'Excelente, coche nuevo, cómodo y puntual. Muy buen servicio.',
    autor: 'Jose Martínez',
  },
  {
    texto: 'Un servicio y trato de 10. Gestión rápida y eficaz. ¡No dudéis en llamarlo!',
    autor: 'Natibel Bernabé',
  },
];
---

<section class="opiniones">
  <div class="contenedor">
    <h2 class="reveal reveal--up">Lo que dicen nuestros clientes</h2>

    <div class="opiniones__rating reveal reveal--up">
      <span class="opiniones__estrellas" aria-label="5 de 5 estrellas">★★★★★</span>
      <span class="opiniones__fuente">Reseñas de 5 estrellas de clientes en Google</span>
    </div>

    <div class="opiniones__grid">
      {opiniones.map((o) => (
        <article class="opinion reveal reveal--up">
          <div class="opinion__top">
            <span class="opinion__avatar" aria-hidden="true">{o.autor.charAt(0)}</span>
            <div>
              <p class="opinion__autor">{o.autor}</p>
              <span class="opinion__estrellas" aria-hidden="true">★★★★★</span>
            </div>
            <svg class="opinion__google" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
              <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
              <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34A21.98 21.98 0 0 0 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/>
              <path fill="#EA4335" d="M24 9.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 3.18 29.93 1 24 1 15.4 1 7.96 5.93 4.34 14.12l7.35 5.7C13.42 13.62 18.27 9.75 24 9.75z"/>
            </svg>
          </div>
          <p class="opinion__texto">“{o.texto}”</p>
        </article>
      ))}
    </div>

    <a class="opiniones__cta reveal reveal--up" href={GOOGLE_URL} target="_blank" rel="noopener">
      Ver todas las reseñas en Google
    </a>
  </div>
</section>
