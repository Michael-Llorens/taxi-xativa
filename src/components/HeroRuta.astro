---
import { getImage } from 'astro:assets';
import castillo from '../assets/img/hero-1.webp';

interface Props {
  titulo: string;
  subtitulo: string;
}
const { titulo, subtitulo } = Astro.props;

const bg = await getImage({ src: castillo, format: 'webp', width: 1600, quality: 72 });
---

<section class="ruta-hero" style={`background-image:url('${bg.src}')`}>
  <div class="contenedor ruta-hero__inner">
    <p class="ruta-hero__kicker">Taxi Xàtiva · Ricardo Llorens</p>
    <h1>{titulo}</h1>
    <p class="ruta-hero__sub">{subtitulo}</p>
    <div class="ruta-hero__ctas">
      <a href="tel:+34722267668" class="btn-amarillo">Llamar: 722 26 76 68</a>
      <a
        href="https://wa.me/34722267668?text=%C2%A1Hola%20Ricardo!%20Quiero%20reservar%20un%20traslado%20al%20aeropuerto."
        target="_blank"
        rel="noopener"
        class="ruta-hero__wa"
      >
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.8 5.5 2.2 7.9L.5 31.5l7.8-2.1c2.3 1.3 4.9 1.9 7.6 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.4 0-4.7-.6-6.7-1.8l-.5-.3-4.6 1.2 1.2-4.5-.3-.5c-1.3-2.1-2-4.5-2-6.9C3.1 8.8 8.9 3 16 3s12.9 5.8 12.9 12.9S23.1 28.8 16 28.8zm7.1-9.6c-.4-.2-2.3-1.1-2.6-1.3-.3-.1-.6-.2-.8.2-.2.4-.9 1.3-1.2 1.5-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.4.5-.7.2-.2.2-.4.4-.7.1-.3 0-.5 0-.7-.1-.2-.8-2-1.1-2.7-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.5-.3.4-1.2 1.2-1.2 2.9 0 1.7 1.2 3.4 1.4 3.6.2.2 2.4 3.7 5.8 5.1.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.6.2-1.8-.1-.1-.3-.2-.7-.4z"/></svg>
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .ruta-hero {
    position: relative;
    background-color: #1c1c1c;
    background-size: cover;
    background-position: center;
    color: #fff;
    padding: 90px 0;
  }
  .ruta-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,.7) 0%, rgba(0,0,0,.5) 60%, rgba(0,0,0,.4) 100%);
  }
  .ruta-hero__inner { position: relative; z-index: 1; max-width: 760px; }
  .ruta-hero__kicker {
    font-family: var(--fuente-titulo);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .85rem;
    color: var(--amarillo);
    margin-bottom: 14px;
  }
  .ruta-hero h1 { font-size: clamp(28px, 4.4vw, 44px); line-height: 1.15; margin-bottom: 16px; }
  .ruta-hero__sub { font-size: 1.05rem; line-height: 1.6; color: #eee; margin-bottom: 28px; max-width: 620px; }
  .ruta-hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .ruta-hero__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 6px;
    border: 2px solid var(--whatsapp);
    background: rgba(37, 211, 102, 0.14);
    color: #fff;
    font-weight: 700;
    transition: background .2s, transform .2s;
  }
  .ruta-hero__wa svg { width: 20px; height: 20px; fill: var(--whatsapp); }
  .ruta-hero__wa:hover { background: var(--whatsapp-btn); transform: translateY(-2px); }
  .ruta-hero__wa:hover svg { fill: #fff; }

  @media (max-width: 460px) {
    .ruta-hero { padding: 60px 0; }
    .ruta-hero__ctas .btn-amarillo, .ruta-hero__wa { width: 100%; justify-content: center; text-align: center; }
  }
</style>
