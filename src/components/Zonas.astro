---
const zonas = [
  'Xàtiva', 'Canals', "l'Olleria", 'Genovés', 'La Llosa de Ranes', 'Vallés',
  'Novelé', 'Barxeta', 'Manuel', "l'Énova", 'Montesa', 'Vallada',
  'Moixent', 'Ontinyent', 'Alzira', 'La Costera',
];
---

<section class="zonas" id="zonas">
  <div class="contenedor">
    <h2 class="reveal reveal--up">Zonas de servicio</h2>
    <p class="zonas__sub reveal reveal--up">
      Trabajo en Xàtiva y toda La Costera, además de traslados a los aeropuertos de Valencia
      y Alicante y cualquier otro destino que necesites.
    </p>
    <ul class="zonas__lista reveal reveal--up">
      {zonas.map((z) => (
        <li class="zonas__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" fill="currentColor"/></svg>
          {z}
        </li>
      ))}
    </ul>
  </div>
</section>
