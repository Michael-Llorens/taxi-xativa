---
import '../styles/global.css';
import Cookies from '../components/Cookies.astro';
import Analytics from '@vercel/analytics/astro';
import { getImage } from 'astro:assets';
import hero1img from '../assets/img/hero-1.webp';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Taxi Xàtiva | Ricardo Llorens — Radio Taxi en Xàtiva y Valencia',
  description = 'Taxi en Xàtiva con más de 10 años de experiencia. Puntualidad, comodidad y confianza. Traslados locales, aeropuertos y empresas. Reserva: 722 26 76 68.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://taxixativa.es').href;

const heroSm = await getImage({ src: hero1img, format: 'webp', width: 800, quality: 75 });
const heroMd = await getImage({ src: hero1img, format: 'webp', width: 1080, quality: 72 });
const heroLg = await getImage({ src: hero1img, format: 'webp', width: 1600, quality: 72 });
// Usar el origen real de la petición para que WhatsApp pueda cargar la imagen en cualquier dominio
const ogImage = new URL('/img/og-taxi-castillo.jpg', Astro.url.origin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TaxiService', 'LocalBusiness'],
  '@id': 'https://taxixativa.es/#taxi',
  name: 'Taxi Xàtiva — Ricardo Llorens',
  description,
  telephone: '+34722267668',
  email: 'ricardotaxixativa@gmail.com',
  url: 'https://taxixativa.es',
  image: ogImage,
  logo: new URL('/img/logo.webp', Astro.site ?? 'https://taxixativa.es').href,
  priceRange: '€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Efectivo, Tarjeta',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Xàtiva',
    addressLocality: 'Xàtiva',
    addressRegion: 'Valencia',
    postalCode: '46800',
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 38.9916788, longitude: -0.5244715 },
  hasMap: 'https://maps.app.goo.gl/pBQKcu91jcASpt816',
  sameAs: ['https://maps.app.goo.gl/pBQKcu91jcASpt816'],
  areaServed: [
    { '@type': 'City', name: 'Xàtiva' },
    { '@type': 'AdministrativeArea', name: 'La Costera' },
    { '@type': 'City', name: 'Valencia' },
    { '@type': 'City', name: 'Alicante' },
    { '@type': 'AdministrativeArea', name: 'Comunitat Valenciana' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  availableLanguage: ['es', 'ca'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    bestRating: '5',
    worstRating: '1',
    ratingCount: '6',
    reviewCount: '6',
  },
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffd331" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taxi Xàtiva" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Taxi Xàtiva de Ricardo Llorens frente al Castillo de Xàtiva" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Taxi Xàtiva de Ricardo Llorens frente al Castillo de Xàtiva" />

    <link rel="icon" href="/img/favicon.jpg" />
    <link rel="apple-touch-icon" href="/img/favicon.jpg" />
    <!-- Preload LCP hero image — in head so the browser discovers it as early as possible -->
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      href={heroSm.src}
      imagesrcset={`${heroSm.src} 800w, ${heroMd.src} 1080w, ${heroLg.src} 1600w`}
      imagesizes="100vw"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Gafata&family=Lato:wght@400;700;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gafata&family=Lato:wght@400;700;900&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gafata&family=Lato:wght@400;700;900&display=swap" /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />

    <Cookies />

    <script>
      // Sombra del header al hacer scroll
      const cabecera = document.querySelector('.cabecera');
      const onScroll = () => {
        if (cabecera) cabecera.classList.toggle('cabecera--scroll', window.scrollY > 30);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Animaciones de aparición al hacer scroll (fadeInLeft/Right/Up)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
