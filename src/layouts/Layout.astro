---
import '../styles/global.css';
import Cookies from '../components/Cookies.astro';
import { getImage } from 'astro:assets';
import hero1img from '../assets/img/hero-1.webp';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Precarga la imagen del hero (solo en páginas que lo muestran) */
  hero?: boolean;
}

const {
  title = 'Taxi Xàtiva | Ricardo Llorens — Radio Taxi en Xàtiva y Valencia',
  description = 'Taxi en Xàtiva con más de 10 años de experiencia. Puntualidad, comodidad y confianza. Traslados locales, aeropuertos y empresas. Reserva: 722 26 76 68.',
  noindex = false,
  hero = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.taxixativa.es');
const canonical = new URL(Astro.url.pathname, site).href;

// Mismos parámetros que en Hero.astro para que la precarga y la <img> sean el mismo archivo.
// El original mide 1036 px de ancho: no tiene sentido pedir variantes mayores.
const heroSm = await getImage({ src: hero1img, format: 'webp', width: 640, quality: 60 });
const heroMd = await getImage({ src: hero1img, format: 'webp', width: 828, quality: 60 });
const heroLg = await getImage({ src: hero1img, format: 'webp', width: 1036, quality: 60 });
const ogImage = new URL('/img/og-taxi-castillo.jpg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TaxiService', 'LocalBusiness'],
  '@id': new URL('/#taxi', site).href,
  name: 'Taxi Xàtiva — Ricardo Llorens',
  description,
  telephone: '+34722267668',
  email: 'ricardotaxixativa@gmail.com',
  url: site.href,
  image: ogImage,
  logo: new URL('/img/logo.webp', site).href,
  priceRange: '€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Efectivo, Tarjeta',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Xàtiva',
    addressLocality: 'Xàtiva',
    addressRegion: 'Valencia',
    postalCode: '46800',
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 38.9916788, longitude: -0.5244715 },
  hasMap: 'https://maps.app.goo.gl/pBQKcu91jcASpt816',
  sameAs: ['https://maps.app.goo.gl/pBQKcu91jcASpt816'],
  areaServed: [
    { '@type': 'City', name: 'Xàtiva' },
    { '@type': 'AdministrativeArea', name: 'La Costera' },
    { '@type': 'City', name: 'Valencia' },
    { '@type': 'City', name: 'Alicante' },
    { '@type': 'City', name: 'Gandia' },
    { '@type': 'City', name: 'Ontinyent' },
    { '@type': 'City', name: 'Canals' },
    { '@type': 'City', name: "l'Olleria" },
    { '@type': 'City', name: 'Genovés' },
    { '@type': 'City', name: 'La Llosa de Ranes' },
    { '@type': 'City', name: 'Vallés' },
    { '@type': 'City', name: 'Novelé' },
    { '@type': 'City', name: 'Barxeta' },
    { '@type': 'City', name: 'Manuel' },
    { '@type': 'City', name: "l'Énova" },
    { '@type': 'City', name: 'Montesa' },
    { '@type': 'City', name: 'Vallada' },
    { '@type': 'City', name: 'Moixent' },
    { '@type': 'City', name: 'Alzira' },
    { '@type': 'AdministrativeArea', name: 'Comunitat Valenciana' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '21:00',
  },
  availableLanguage: ['es', 'ca'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    bestRating: '5',
    worstRating: '1',
    ratingCount: '6',
    reviewCount: '6',
  },
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager — carga diferida y solo si hay consentimiento de cookies -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function _gtmLoad(){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-P78DDQCV');}
      window._gtmLoad = _gtmLoad;
      var _cookieConsent;
      try { _cookieConsent = localStorage.getItem('taxi_cookies_ok'); } catch (e) { _cookieConsent = null; }
      if (_cookieConsent === 'aceptado') {
        if(document.readyState==='complete'){setTimeout(_gtmLoad,1);}else{window.addEventListener('load',function(){setTimeout(_gtmLoad,1);},{once:true});}
      }
    </script>
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffd331" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taxi Xàtiva" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Taxi Xàtiva de Ricardo Llorens frente al Castillo de Xàtiva" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Taxi Xàtiva de Ricardo Llorens frente al Castillo de Xàtiva" />

    <link rel="icon" type="image/png" sizes="96x96" href="/img/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/img/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Preload LCP hero image — in head so the browser discovers it as early as possible -->
    {hero && (
      <link
        rel="preload"
        as="image"
        fetchpriority="high"
        href={heroSm.src}
        imagesrcset={`${heroSm.src} 640w, ${heroMd.src} 828w, ${heroLg.src} 1036w`}
        imagesizes="100vw"
      />
    )}
    <!-- Sin JavaScript, los bloques con animación de aparición deben verse igualmente -->
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P78DDQCV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />

    <Cookies />

    <script>
      // Sombra del header al hacer scroll
      const cabecera = document.querySelector('.cabecera');
      const onScroll = () => {
        if (cabecera) cabecera.classList.toggle('cabecera--scroll', window.scrollY > 30);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Animaciones de aparición al hacer scroll (fadeInLeft/Right/Up)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
