---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroRuta from '../components/HeroRuta.astro';
import RutaBeneficios from '../components/RutaBeneficios.astro';
import ComoReservar from '../components/ComoReservar.astro';
import Calculadora from '../components/Calculadora.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Whatsapp from '../components/Whatsapp.astro';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://taxixativa.es/' },
    { '@type': 'ListItem', position: 2, name: 'Taxi Xàtiva a Gandia', item: 'https://taxixativa.es/taxi-gandia' },
  ],
};
---

<Layout
  title="Taxi Xàtiva → Gandia | Ricardo Llorens — Traslados directos"
  description="Taxi de Xàtiva a Gandia y vuelta. 47 km en unos 35 minutos, precio orientativo desde 65 €. Puntual y sin sorpresas. Reserva con Ricardo: 722 26 76 68."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <Header />
  <main id="contenido">
    <HeroRuta
      titulo="Taxi de Xàtiva a Gandia"
      subtitulo="Traslados directos entre Xàtiva (y toda La Costera) y Gandia. Cómodo, puntual y con precio fijo acordado de antemano."
    />
    <RutaBeneficios
      intro="El trayecto de Xàtiva a Gandia son aproximadamente 47 km por la CV-60, unos 35–40 minutos de viaje. El precio orientativo ronda los 65 € según la tarifa oficial (1,37 €/km día normal). Te llevo y te recojo sin paradas, con total comodidad y sin sorpresas en el precio."
    />
    <ComoReservar />
    <Calculadora />
    <Contacto />
  </main>
  <Footer />
  <Whatsapp />
</Layout>
