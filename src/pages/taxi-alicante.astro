---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ventajas from '../components/Ventajas.astro';
import RutaInfo from '../components/RutaInfo.astro';
import ComoReservar from '../components/ComoReservar.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Whatsapp from '../components/Whatsapp.astro';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://taxixativa.es/' },
    { '@type': 'ListItem', position: 2, name: 'Taxi Xàtiva a Alicante', item: 'https://taxixativa.es/taxi-alicante' },
  ],
};
---

<Layout
  title="Taxi Xàtiva → Alicante | Ricardo Llorens — Traslados directos"
  description="Taxi de Xàtiva a Alicante ciudad y vuelta. Traslado directo en poco más de 1 hora, sin transbordos y con precio acordado. Reserva: 722 26 76 68."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <Header />
  <main id="contenido">
    <Hero
      titulo="Taxi de Xàtiva a Alicante"
      ctaHref="#contacto"
    />
    <Ventajas />
    <RutaInfo
      titulo="Traslado directo de Xàtiva a Alicante"
      intro="El trayecto de Xàtiva a Alicante son aproximadamente 110 km por la A-7/AP-7, alrededor de 1 hora y 10 minutos de viaje. Traslado directo puerta a puerta, sin transbordos, con total tranquilidad durante todo el recorrido."
    />
    <ComoReservar />
    <Contacto />
  </main>
  <Footer />
  <Whatsapp />
</Layout>
