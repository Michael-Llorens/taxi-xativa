---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RutaBeneficios from '../components/RutaBeneficios.astro';
import ComoReservar from '../components/ComoReservar.astro';
import Calculadora from '../components/Calculadora.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Whatsapp from '../components/Whatsapp.astro';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://taxixativa.es/' },
    { '@type': 'ListItem', position: 2, name: 'Taxi Xàtiva a Alicante', item: 'https://taxixativa.es/taxi-alicante' },
  ],
};
---

<Layout
  title="Taxi Xàtiva → Alicante | Ricardo Llorens — Traslados directos"
  description="Taxi de Xàtiva a Alicante ciudad y vuelta. 110 km en poco más de 1 hora, precio orientativo desde 150 €. Sin esperas ni transbordos. Reserva: 722 26 76 68."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <Header />
  <main id="contenido">
    <Hero
      titulo="Taxi de Xàtiva a Alicante"
      subtitulo="Sin transbordos, puerta a puerta y precio fijo."
      ctaHref="#contacto"
    />
    <RutaBeneficios
      intro="El trayecto de Xàtiva a Alicante son aproximadamente 110 km por la A-7/AP-7, alrededor de 1 hora y 10 minutos de viaje. El precio orientativo ronda los 150 € según la tarifa oficial (1,37 €/km día normal). Traslado puerta a puerta, sin paradas y con total tranquilidad."
    />
    <ComoReservar />
    <Calculadora />
    <Contacto />
  </main>
  <Footer />
  <Whatsapp />
</Layout>
