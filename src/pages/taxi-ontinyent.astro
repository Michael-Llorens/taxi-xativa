---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ventajas from '../components/Ventajas.astro';
import RutaInfo from '../components/RutaInfo.astro';
import ComoReservar from '../components/ComoReservar.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Whatsapp from '../components/Whatsapp.astro';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://taxixativa.es/' },
    { '@type': 'ListItem', position: 2, name: 'Taxi Xàtiva a Ontinyent', item: 'https://taxixativa.es/taxi-ontinyent' },
  ],
};
---

<Layout
  title="Taxi Xàtiva → Ontinyent | Ricardo Llorens — Traslados directos"
  description="Taxi de Xàtiva a Ontinyent y vuelta. Traslado directo en unos 25 minutos, puntual y con precio fijo acordado. Reserva: 722 26 76 68."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <Header />
  <main id="contenido">
    <Hero
      titulo="Taxi de Xàtiva a Ontinyent"
      ctaHref="#contacto"
    />
    <Ventajas />
    <RutaInfo
      titulo="Traslado directo de Xàtiva a Ontinyent"
      intro="El trayecto de Xàtiva a Ontinyent son aproximadamente 27 km por la CV-660, unos 25–30 minutos de viaje. Un traslado rápido, cómodo y sin complicaciones para moverte entre ambas localidades cuando lo necesites."
    />
    <ComoReservar />
    <Contacto />
  </main>
  <Footer />
  <Whatsapp />
</Layout>
