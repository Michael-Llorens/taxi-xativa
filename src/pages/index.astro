---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ventajas from '../components/Ventajas.astro';
import QuienSoy from '../components/QuienSoy.astro';
import PorQue from '../components/PorQue.astro';
import Servicios from '../components/Servicios.astro';
import ComoReservar from '../components/ComoReservar.astro';
import Calculadora from '../components/Calculadora.astro';
import Zonas from '../components/Zonas.astro';
import Opiniones from '../components/Opiniones.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Whatsapp from '../components/Whatsapp.astro';
---

<Layout>
  <Header />
  <main id="contenido">
    <Hero />
    <Ventajas />
    <QuienSoy />
    <PorQue />
    <Servicios />
    <ComoReservar />
    <Calculadora />
    <Zonas />
    <Faq />
    <Contacto />
    <Opiniones />
  </main>
  <Footer />
  <Whatsapp />
</Layout>
