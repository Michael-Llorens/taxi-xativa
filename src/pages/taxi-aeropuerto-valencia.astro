---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ventajas from '../components/Ventajas.astro';
import RutaInfo from '../components/RutaInfo.astro';
import ComoReservar from '../components/ComoReservar.astro';
import Calculadora from '../components/Calculadora.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Whatsapp from '../components/Whatsapp.astro';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://taxixativa.es/' },
    { '@type': 'ListItem', position: 2, name: 'Taxi al Aeropuerto de Valencia', item: 'https://taxixativa.es/taxi-aeropuerto-valencia' },
  ],
};
---

<Layout
  title="Taxi Xàtiva → Aeropuerto de Valencia | Traslados directos"
  description="Taxi de Xàtiva al aeropuerto de Valencia (Manises) y vuelta. Traslados directos y puntuales con precio acordado. Reserva con Ricardo: 722 26 76 68."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <Header />
  <main id="contenido">
    <Hero
      titulo="Taxi de Xàtiva al Aeropuerto de Valencia"
      ctaHref="#contacto"
    />
    <Ventajas />
    <RutaInfo
      titulo="Traslado directo al aeropuerto de Valencia"
      intro="El aeropuerto de Valencia (Manises) está a unos 70 km de Xàtiva, alrededor de 50 minutos de viaje. Realizo traslados directos, sin paradas innecesarias, para que llegues con tiempo de sobra a tu vuelo. Reserva con antelación y deja que me ocupe de todo."
    />
    <ComoReservar />
    <Calculadora />
    <Contacto />
  </main>
  <Footer />
  <Whatsapp />
</Layout>
